APP_NAME=Movie AI Workspace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://movie.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@example.com
MAIL_FROM_NAME="${APP_NAME}"

DB_CONNECTION=pgsql
DB_HOST=movie-postgres
DB_PORT=5432
DB_DATABASE=movie_portal
DB_USERNAME=movie_portal
DB_SSLMODE=disable

REDIS_CLIENT=predis
REDIS_HOST=movie-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=movie.example.com
SESSION_COOKIE=movie_portal_session

TRUSTED_PROXIES=192.168.88.30
MOVIE_DISPLAY_TIMEZONE=America/Los_Angeles
MOVIE_REQUIRE_TOTP=true
MOVIE_BOOKING_HORIZON_DAYS=14
MOVIE_MAX_FUTURE_RESERVATIONS=2
MOVIE_START_STEP_MINUTES=15
MOVIE_CANCELLATION_CUTOFF_MINUTES=30
MOVIE_NO_SHOW_MINUTES=15
MOVIE_FREE_SPACE_FLOOR_GB=500
MOVIE_ALLOWED_NODE_CIDRS=192.168.88.0/24
MOVIE_WORKSPACE_ENABLED=true
MOVIE_COMPANY_CODEX_ENABLED=false
MOVIE_TERMINAL_ROUTER_SECRET_FILE=/run/secrets/router_hmac_secret
MOVIE_WORKSPACE_IDLE_MINUTES=240
MOVIE_MAX_CONCURRENT_WORKSPACES=3
MOVIE_COMPANY_CODEX_VOLUME=movie_company_codex_auth
MOVIE_VIDEO_ROOT=/srv/movie-outputs
MOVIE_MANAGER_URL=http://movie-workspace-manager:8080
MOVIE_MANAGER_SECRET_FILE=/run/secrets/manager_hmac_secret
MOVIE_BROKER_CONTROL_URL=http://movie-ai-broker:8080
MOVIE_BROKER_SECRET_FILE=/run/secrets/broker_hmac_secret
MOVIE_CODEX_VERSION=0.149.1
