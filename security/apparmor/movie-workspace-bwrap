# Movie Portal Workspace AppArmor profile.
#
# This is derived from Moby's docker-default profile at Docker Engine commit
# 6a43e3d. It is assigned only to the ephemeral Workspace container. The only
# Bubblewrap inherits this domain because Docker's mandatory
# no-new-privileges setting correctly blocks an initial AppArmor domain
# transition. Docker capability dropping, the project seccomp profile,
# read-only rootfs, and volume/network restrictions remain separate controls.

abi <abi/3.0>,

#include <tunables/global>

profile movie-workspace-bwrap flags=(attach_disconnected,mediate_deleted) {
  network,
  deny network alg,
  capability,
  file,
  mount,
  umount,
  pivot_root,
  userns,

  # Keep Bubblewrap in the already-confined container domain. An initial px
  # transition is incompatible with Docker no-new-privileges and is denied by
  # the kernel before Bubblewrap can create its namespace.
  ix /usr/bin/bwrap,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=movie-workspace-bwrap,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,tracedby,read,readby) peer=movie-workspace-bwrap,
}
