APP_NAME="Movie AI Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://movie.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=movie-postgres
DB_PORT=5432
DB_DATABASE=movie_portal
DB_USERNAME=movie_portal_app
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
MOVIE_WORKSPACE_MUTATION_LOCK_SECONDS=180
MOVIE_WORKSPACE_MUTATION_LOCK_WAIT_SECONDS=120
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=movie-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@example.com"
MAIL_FROM_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
TRUSTED_PROXIES=192.168.88.30
MOVIE_DISPLAY_TIMEZONE=America/Los_Angeles
MOVIE_REQUIRE_TOTP=true
MOVIE_BROKER_CONTROL_URL=http://movie-ai-router:8080
MOVIE_LOCAL_NODE_BROKER_URL=http://movie-ai-broker:8080
MOVIE_ALLOWED_NODE_CIDRS=192.168.88.0/24
MOVIE_LOCAL_COMPUTE_NODE_SLUG=ai-server-01
MOVIE_NODE_WORKER_PORT=8080
MOVIE_NODE_HEARTBEAT_STALE_SECONDS=30
MOVIE_REQUIRED_WORKER_REVISION=
MOVIE_REQUIRED_WORKFLOW_REVISION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
