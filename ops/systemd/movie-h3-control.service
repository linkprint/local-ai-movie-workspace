[Unit]
Description=Movie AI H3 fixed host control
Requires=movie-h3-control.socket
After=movie-h3-control.socket docker.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/movie-ai/host-control.env
Environment=MOVIE_H3_CONTROL_SECRET_FILE=/srv/movie-portal/env/h3_control_hmac_secret
ExecStart=/usr/bin/python3 /srv/movie-portal/host-control/movie_h3_control.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/run/movie-h3-control
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
